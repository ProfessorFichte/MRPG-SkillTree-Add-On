{
	"schemaVersion": 1,
	"id": "mrpgc_skill_tree",
	"version": "${version}",
	"name": "MRPG Classes - RPG-Series Skill Tree Add On",
	"description": "RPG Series Skill Tree Add-On for the More RPG Classes!",
	"authors": [
		"Fichte"
	],
	"contact": {
		"sources": "https://github.com/ProfessorFichte"
	},
	"license": "All Rights Reserved",
	"icon": "assets/mrpgc_skill_tree/icon.png",
